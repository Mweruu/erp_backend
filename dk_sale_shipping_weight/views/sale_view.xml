<odoo>
    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">dk_sale_automatic_workflow.sale_order.view_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <label for="shipping_weight" string="Weight"/>
                <div>
                    <field name="shipping_weight" readonly="1" class="oe_inline"/>
                    <field name="weight_uom_name" readonly="1" nolabel="1" class="oe_inline" style="margin-left:5px"/>
                </div>
            </field>
        </field>
    </record>
</odoo>