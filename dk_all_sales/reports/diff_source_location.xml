<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="diff_source_location_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <div class="text-center">
                </div>
                <div class="text-center">
                    <h2>Changes in Expected Source Location</h2>
                    <p>Date from:
                        <t t-esc='date_from'/>
                        - Date to:
                        <t t-esc='date_to'/>
                    </p>
                </div>
                <div>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <td>
                                    <b>Date</b>
                                </td>
                                <td>
                                    <b>Name</b>
                                </td>
                                <td>
                                    <b>Expected Source Location</b>
                                </td>
                                <td>
                                    <b>Source Location</b>
                                </td>
                                <td>
                                    <b>Source Document</b>
                                </td>
                                <td>
                                    <b>Delay Picking</b>
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="records" t-as="d">
                                <tr>
                                    <td>
                                        <t t-esc="d['date']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['Name']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['Expected Shipping Location']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['Source location']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['Source Document']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['ship later']"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="6">
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
    <record id="diff_source_location_report" model="ir.actions.report">
        <field name="name">Changes in Expected Source Location</field>
        <field name="model">diff.source.location.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dk_all_sales.diff_source_location_report_template</field>
        <field name="report_file">dk_all_sales.diff_source_location_report_template</field>
        <field name="print_report_name">'Changes in Expected Source Location'</field>
        <field name="binding_model_id" ref="model_diff_source_location_report"/>
        <field name="binding_type">report</field>
    </record>
</odoo>