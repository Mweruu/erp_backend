<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">l10n.ke.tremol.inherit.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='l10n_ke_cu_details']" position="after">
                <div class="row mt16 o_settings_container" id="is_product_name_view">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="is_set_product_name"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="is_set_product_name"/>
                            <div class="text-muted">
                                Add a custom product name
                            </div>
                            <div class="content-group mt16"
                                 attrs="{'invisible' : [('is_set_product_name', '=', False)]}">
                                <div>
                                    <field name="is_product_name" placeholder="e.g. Four Person Desk"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>