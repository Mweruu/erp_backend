<odoo>
    <record id="tax_report_wizard" model="ir.ui.view">
        <field name="name">tax_report_wizard</field>
        <field name="model">tax.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="sale_type"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="date_from"/>
                        </group>
                        <group>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <footer>
                        <button type="object" string="Print CSV" name="action_print_tax_report_csv"/>
                        <button type="object" string="Download PDF" name="action_print_tax_report"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="tax_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Tax report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tax.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="tax_report_wizard"/>
    </record>
    <menuitem id="tax_menu_item" name="Tax Report" parent="point_of_sale.menu_point_rep" sequence="100"
              action="tax_report_wizard_action" groups="point_of_sale.group_pos_manager"/>
</odoo>