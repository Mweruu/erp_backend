<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="tremol_data_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="text-center">
                </div>
                <div class="text-center">
                    <h2>Tremol Data</h2>
                    <p>Date from:
                        <t t-esc='date_from'/>
                        - Date to:
                        <t t-esc='date_to'/>
                    </p>
                </div>
                <div>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <td>
                                    <b>Datetime</b>
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="records" t-as="d">
                                <tr>
                                    <td>
                                        <t t-esc="d['Datetime']"/>
                                    </td>
                                </tr>
                            </t>
<!--                            <tr>-->
<!--                                <td colspan="4">-->
<!--                                    <div class="text-right">-->
<!--                                        <b>Total</b>-->
<!--                                    </div>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <b t-esc='round(total, 2)'/>-->
<!--                                </td>-->
<!--                            </tr>-->
<!--                            <tr>-->
<!--                                <td colspan="5">-->
<!--                                </td>-->
<!--                            </tr>-->
                        </tbody>
                    </table>
                </div>
            </t>

        </t>
    </template>
    <record id="tremol_data" model="ir.actions.report">
        <field name="name">Tremo Data Report</field>
        <field name="model">tremol.data</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dk_pos_tremol_integration.tremol_data_template</field>
        <field name="report_file">dk_pos_tremol_integration.tremol_data_template</field>
        <field name="print_report_name">'Tremol data'</field>
        <field name="binding_model_id" ref="model_tremol_data"/>
        <field name="binding_type">report</field>
    </record>
</odoo>