<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="custom_pos_config_extended_form_view">
        <field name="name">pos.config.form.extended.return.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pos_interface_section']" position="after">
                <br/>
                <h2>Configure Return Policy</h2>
                <div class="row mt16 o_settings_container" id="session_return_config">
                    <div id="show_r_is_show_all_orders_button" class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_is_show_all_orders"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_is_show_all_orders" string='Is Show All Orders On Refund'/>
                        </div>
                    </div>
                    <div id="show_r_is_enabled_refund" class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_is_enabled_refund"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_is_enabled_refund" string='Is Enabled Refund Qty'/>
                        </div>
                    </div>
                    <div id="show_r_is_enabled_print_on_refund" class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_is_enabled_print_on_refund"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_is_enabled_print_on_refund" string='Is Enabled Print Receipt onRefund'/>
                        </div>
                    </div>
                    <div id="show_r_is_enabled_invoice" class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_is_enabled_invoice"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_is_enabled_invoice" string='Is Enabled to Create invoice from POS'/>
                        </div>
                    </div>
                    <div id="show_r_max_day_refund" class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_max_day_refund" string='Set Max Days Of Return/Refund Qty'/>
                            <field name="pos_max_day_refund"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
