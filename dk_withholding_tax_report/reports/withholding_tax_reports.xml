<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="withholding_tax_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="text-center">
                </div>
                <div class="text-center">
                    <h2>Withholding Tax Report</h2>
                    <p>Date from:
                        <t t-esc='date_from'/>
                        - Date to:
                        <t t-esc='date_to'/>
                    </p>
                    <p>For:
                        <t t-esc="partner_type"/>
                    </p>
                </div>
                <div>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <td>
                                    <b>Datetime</b>
                                </td>
                                <td>
                                    <b>Journal Entry</b>
                                </td>
                                <td>
                                    <b>Customer / Vendor</b>
                                </td>
                                <td style="width:40%">
                                    <b>Label</b>
                                </td>
                                <td>
                                    <b>Amount in currency</b>
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="records" t-as="d">
                                <tr>
                                    <td>
                                        <t t-esc="d['Datetime']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['Journal Entry']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['Customer']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['Label']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['Amount']"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div class="oe-right text-right">
                        <h3>Total:
                            <t t-esc="grand_total"/>
                        </h3>
                    </div>
                </div>
            </t>
        </t>
    </template>
    <record id="withholding_tax_report" model="ir.actions.report">
        <field name="name">Withholding Tax</field>
        <field name="model">withholding.tax.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dk_withholding_tax_report.withholding_tax_report_template</field>
        <field name="report_file">dk_withholding_tax_report.withholding_tax_report_template</field>
        <field name="print_report_name">'Withholding Tax'</field>
        <field name="binding_model_id" ref="model_withholding_tax_report"/>
        <field name="binding_type">report</field>
    </record>
</odoo>