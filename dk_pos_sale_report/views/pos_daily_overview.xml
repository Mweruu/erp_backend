<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_daily_overview_report_wizard" model="ir.ui.view">
        <field name="name">pos_daily_overview_report_wizard</field>
        <field name="model">pos.order.daily_report.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name='date'/>
                        </group>
                    </group>

                    <footer>
                        <button type="object" string="Print CSV" name="action_print_pos_order_daily_report_csv"/>
                        <button type="object" string="Download PDF" name="action_print_pos_order_daily_report"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pos_daily_overview_report_wizard_action" model="ir.actions.act_window">
        <field name="name">POS Daily Overview Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pos.order.daily_report.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref='pos_daily_overview_report_wizard'/>
    </record>
    <menuitem id="pos_daily_overview_menu_item" name="POS Daily Overview Report" parent="point_of_sale.menu_point_rep"
              sequence="100"
              action="pos_daily_overview_report_wizard_action" groups="point_of_sale.group_pos_manager"/>
</odoo>