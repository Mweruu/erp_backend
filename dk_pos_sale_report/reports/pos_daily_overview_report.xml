<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pos_order_daily_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="text-center">
                </div>
                <div class="text-center">
                    <h2>POS Daily Overview Report</h2>

                    <p>Date :
                        <t t-esc='date'/>
                    </p>
                </div>
                <div>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <td>
                                    <b>Sales Persons</b>
                                </td>
                                <td>
                                    <b>Total Sales</b>
                                </td>
                                <td>
                                    <b>Total Refunds</b>
                                </td>
                                <td>
                                    <b>Gift Card Rewardline</b>
                                </td>
                                <td>
                                    <b>Net Cash</b>
                                </td>
                                <td>
                                    <b>GiftCard buy Total</b>
                                </td>

                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="records" t-as="d">
                                <tr>
                                    <td>
                                        <t t-esc="d['salesperson']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['tot']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['total_refunds']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['total_rewards']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['Total Sales']"/>
                                    </td>
                                    <td>
                                        <t t-esc="d['gc_total']"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="1">
                                    <div class="text-right">
                                        <b>Total</b>
                                    </div>
                                </td>
                                <td>
                                    <b t-esc='round(sales_total,2)'/>
                                </td>
                                <td>
                                    <b t-esc='round(refunds_total,2)'/>
                                </td>
                                <td>
                                    <b t-esc='round(coupons_total,2)'/>
                                </td>
                                <td>
                                    <b t-esc='round(all_sales_total,2)'/>
                                </td>
                                <td>
                                    <b t-esc='round(gc_grand_total,2)'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
    <record id="pos_order_daily_report" model="ir.actions.report">
        <field name="name">POS Daily Overview Report</field>
        <field name="model">pos.order.daily_report.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dk_pos_sale_report.pos_order_daily_report_template</field>
        <field name="report_file">dk_pos_sale_report.pos_order_daily_report_template</field>
        <field name="print_report_name">'pos order daily_report'</field>
        <field name="binding_model_id" ref="model_pos_order_daily_report_report"/>
        <field name="binding_type">report</field>
    </record>
</odoo>