<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.point_of_sale</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pos_bills_and_receipts_section']" position="after">
                <div class="row mt16 o_settings_container" id="pos_receipts_section">
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_is_custom_receipt"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_receipt_design"/>
                            <div class="text-muted">
                                Use Custom Receipt Design
                            </div>
                            <div class="content-group mt16">
                                <field name="pos_receipt_design"
                                       attrs="{'invisible': [('pos_is_custom_receipt', '=', False)]}"/>
                            </div>
                            <div class="content-group mt16">
                                <field name="pos_design_receipt"
                                       invisible="1"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@id='pos_pricing_section']" position="after">
                <div class="row mt16 o_settings_container" id="pos_receipts_section">
                    <div class="col-xs-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_toggle_sign"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_toggle_sign"/>
                            <div class="text-muted">
                                Allow cashiers to use the toggle sign
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_view_quotation_order"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_view_quotation_order"/>
                            <div class="text-muted">
                                Allow cashiers to view Quotations/Orders Button
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_view_enter_code"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_view_enter_code"/>
                            <div class="text-muted">
                                Allow cashiers to redeem Gift Cards
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-lg-6 o_setting_box"
                         id="set_percentage_range_container">
                        <div class="o_setting_left_pane">
                            <field name="pos_set_percentage_range_bool"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_set_percentage_range_bool"/>
                            <div class="text-muted">
                                Set the percentage range allowed between selling and list price
                            </div>
                            <div class="content-group">
                                <field name="pos_set_percentage_range" class="o_light_label"
                                       style="width: 50px;"/>
                                <span>%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>