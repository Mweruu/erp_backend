<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('payment-controls')]" position="inside">
              <style>
                .button.colours-selection-blue{
                    background-color: blue !important;
                    color: white !important;
                    }
                .button.colours-selection-yellow{
                    background-color: yellow !important;
                    color: black !important;
                    }
            </style>
            <div class="input" id="customer_number">
                <input style="border:white; height: 60px; width:100%;
                    padding-left: 40px;
                    border: solid 1px rgb(209, 209, 209);"
                       type="number"
                       t-on-input="_updateInputValue"
                       t-att-value="currentOrder.customer_number"
                       placeholder="Enter Customer Number"/>
            </div>
            <div class="input" id="vat_number">
                <input style="border:white; height: 60px; width:100%;
                    padding-left: 40px;
                    border: solid 1px rgb(209, 209, 209);"
                       t-on-input="_updateVATInputValue"
                       t-att-disabled="currentOrder.partner ? 'disabled' : undefined"
                       t-att-value="currentOrder.partner?.vat ?? currentOrder.vat_number"
                       t-att-readonly="currentOrder.partner !== null ? true : undefined"
                       placeholder="Enter PIN Number"/>
            </div>
            <div class="button colours-selection-yellow change-color-button" t-on-click="toggleChangeColour">
                <i class="fa fa-flag-o"/>
                Select Color
            </div>
        </xpath>
    </t>

    <t t-name="DeliverButton" owl="1">
        <div class="control-button">
            <span>Deliver Receipt</span>
        </div>
    </t>

    <t t-name="OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="after">
            <p t-if="receipt.customer_number" style="font-size: 11px;text-align: center;margin-top: 5px;">Customer Contact: <b
                    t-esc="receipt.customer_number"/></p>
            <t t-if="receipt.delay_picking">
                <h3 style="text-align: center">*** TO COLLECT ***</h3>
            </t>
            <t t-if="receipt.reprinted">
                <h3 style="text-align: center">*** REPRINTED ***</h3>
            </t>
        </xpath>
    </t>
</templates>
