<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="RTDelOrderReceipt">
        <div class="pos-receipt" style="width: 552px">
            <t t-if="receipt.company_details.logo">
                <img style="width: 85%;display: block;margin: auto;" t-att-src='logo' alt="Logo"/>
            </t>
            <div style="text-align:center; font-size: 85%; font-weight: bold; padding-bottom: 5px;">
                <t t-if='receipt.company.name'>
                    <div><t t-esc='receipt.company.name' /></div>
                </t>
                <t t-if='receipt.company.phone'>
                    <div>Tel:<t t-esc='receipt.company.phone'/></div>
                </t>

                <t t-if='receipt.receipt_header'>
                    <t t-esc='receipt.receipt_header'/>
                </t>
                <t t-if='!receipt.receipt_header and receipt.header'>
                    <div><t t-esc='receipt.header' /></div>
                </t>
            </div>
            <br/>
            <!-- Orderlines -->
            <div class='orderlines'>
                <div style="text-align:center; font-size: 85%; font-weight: bold; padding-bottom: 5px;">
                    <div><span t-esc='receipt.pos_reference' /></div>
                    <div>Date :
                        <span t-esc='receipt.validation_date'/>
                    </div>
                    <t t-if='receipt.partners'>
                        <div>Customer: : <t t-esc='receipt.partners'/></div>
                    </t>
                    <t t-if='receipt.customer_number'>
                        <div>Customer Contact: : <t t-esc='receipt.customer_number'/></div>
                    </t>
                    <t t-if='receipt.vat_number'>
                        <div>PIN Number: : <t t-esc='receipt.vat_number' /></div>
                    </t>
                    <t t-if='receipt.cashier'>
                    <div class='cashier'>
                        <div>Served by <t t-esc='receipt.cashier'/></div>
                    </div>
                    </t>
                    <t t-if="receipt.delayed_picking">
                        <h1 style="text-align: center font-size: 130%;">*** TO COLLECT ***</h1>
                    </t>
                </div>
                <t t-if="!receipt.delayed_picking">
                <br/>
                </t>

                <table style="width: 100%;">
                    <tr style="border-bottom: 2px solid black;font-size: 100%; font-weight: 800;">
                        <th align="left">Description</th>
                        <th align="right">Amount</th>
                    </tr>
                    <tr t-foreach="receipt.orderlines" t-as="line" style="font-size: 100%;">
                    <td>
                        <div style="padding-top: 2px;padding-bottom: 2px; font-size: 100%; text-align: left; font-weight: 800;">
                        <t>
                            <span style="font-size: 100%;" t-esc='line.name'/>
                        </t>
                        <t>
                            <div style="font-size: 95%; text-align: left; font-weight: 700; margin-left: 10%;">
                                <span t-esc="line.qty"/>
                                <span t-esc='line.uom'/>
                                @
                                <span t-esc="env.pos.format_currency(line.price)"/>
                            </div>
                        </t>
                        <t t-if='line.discount !== 0'>
                            <h5 style="margin-top: 0%;margin-bottom: 0%;font-size: 90%;font-weight: 700; margin-left: 10%;">  Discount:
                                <t t-esc='line.discount'/>
                            </h5>
                        </t>
                        <t t-if="line.customer_note">
                            <h5 style="margin-top: 0%;margin-bottom: 0%;font-size: 90%;font-weight: 700; margin-left: 10%;"> Customer Note:
                                <t t-esc="line.customer_note"/>
                            </h5>
                        </t>
                        </div>
                    </td>
                        <td style="text-align: right; font-weight: 600;"><span t-esc='env.pos.format_currency_no_symbol(line.subtotalInc)'/></td>
                    </tr>
                </table>
            </div>
            <div>
            <!-- Total -->
                <br/>
                <div style="font-size: 150%;text-align: right;font-weight: 700; border-top: 3px solid;margin-left: 1%;padding-top: 2%;">
                TOTAL :
                <span t-esc='env.pos.format_currency(receipt.total)'/>
            </div>
                <br/>
                <!-- Extra Payment Info -->
                <t t-if='receipt.total_discount'>
                <div style="font-size: 80%;text-align: right;border-top: 1px dashed;margin-left: 30%;padding-top: 1%; padding-bottom: 2%; ">
                    Discounts
                    <span t-esc='env.pos.format_currency(receipt.total_discount)'/>
                </div>
            </t>
                <t t-foreach='receipt.tax_details' t-as='tax'>
                    <div style="font-size: 75%; text-align: right; font-weight: 700; border-top: 1px dashed;margin-left: 30%;padding-top: 1%; padding-bottom: 1%;">
                        <t t-esc='tax.name'/>
                        <span t-esc='env.pos.format_currency_no_symbol(tax.amount)'/>
                    </div>
                </t>
                <div style="font-size: 75%; text-align: right; font-weight: 700; padding-bottom: 1%;">
                    Total Taxes :
                    <span t-esc='env.pos.format_currency(receipt.amount_tax)'/>
                </div>
            </div>
            <div style="border-top: 1px dashed black;padding-top: 1%;">
                    <!-- Payment Lines -->
                <t t-foreach='receipt.paymentlines' t-as='line'>
                    <div style="font-size: 90%;">
                        <t t-if="!line.return">
                            <t t-esc='line.name'/>
                            <span t-esc='env.pos.format_currency_no_symbol(line.amount)'
                                  class="pos-receipt-right-align"/>
                        </t>
                    </div>
                </t>
                <div class="receipt-change" style="font-size: 90%;">
                    CHANGE
                    <span t-esc='env.pos.format_currency(receipt.change)' class="pos-receipt-right-align"/>
                </div>
                <div style="border-top: 1px dashed black;padding-top: 1%;">
                </div>
            </div>

            <div class='before-footer'/>
            <!-- Footer -->
            <br/>
            <hr/>
            <div class='after-footer'>
                <t t-if='receipt.loyaltyStats'>
                    <t t-foreach="receipt.loyaltyStats" t-as="_loyaltyStat" t-key="_loyaltyStat.couponId">
                        <!-- Show only if portal_visible. -->
                        <div t-if="_loyaltyStat.program" class='loyalty'>
                        <span class="pos-receipt-center-align">
                            <br/>
                            <div t-esc='_loyaltyStat.program' class="pos-receipt-title"/>

                            <br/>
                        </span>
                        <!-- Don't use points.total, it's wrong in this context (after the order synced). -->
                        <!-- Show balance as it's updated during _postPushOrderResolve. -->
                        <t t-if='_loyaltyStat.points'>
                            <div>Balance Loyalty Points:
                                <span t-esc='_loyaltyStat.points' class="pos-receipt-right-align"/></div>
                        </t>
                        </div>
                    </t>
                </t>

                <t t-if="receipt.new_coupon_info and receipt.new_coupon_info.length !== 0">
                    <div class="pos-coupon-rewards">
                        <t t-foreach="receipt.new_coupon_info" t-as="coupon_info" t-key="coupon_info.code">
                            <div t-if="!coupon_info['giftcard_info']">
                                <hr/>
                                <br/>
                                <div style="font-size: 130%;">
                                    Coupon Codes
                                </div>
                                <div style="font-size: 110%;">
                                    <t t-esc="coupon_info['program_name']"/>
                                </div>
                                <div>
                                    <span>Valid until: </span>
                                    <t t-if="coupon_info['expiration_date']">
                                        <t t-esc="coupon_info['expiration_date']"/>
                                    </t>
                                    <t t-else="">
                                        no expiration
                                    </t>
                                </div>
                                <div>
                                    <img t-att-src="'/report/barcode/Code128/'+coupon_info['code']"
                                         style="width:400px;height:100px" alt="Barcode"/>
                                </div>
                                <div style="font-size: 110%;">
                                        <t t-esc="coupon_info['code']"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <t t-if="receipt.new_coupon_info">
                    <hr/>
                    <t t-foreach="receipt.new_coupon_info" t-as="giftcode">
                        <div style="padding:0; margin:0px; padding-top:10px; padding-bottom:6px; text-align:center;"
                             t-if="giftcode['giftcard_info']">
                            <div class="pos-receipt-center-align" style="font-size: 90%;">
                                Gift Barcodes
                                <br/>
                            </div>
                            <img t-att-src="'/report/barcode/Code128/'+giftcode.code"
                                 style="width:400px;height:100px"
                                 alt="Barcode"/>
                            <span t-esc="giftcode.code" style="display: block; font-size: 90%;"/>
                            <div style="font-size: 90%;"><b>price : <span
                                    t-esc="env.pos.format_currency(giftcode.points)"/></b></div>
                            <br/>
                        </div>
                    </t>
                    <br/>
                </t>
            </div>
            <div>
            <div t-if='!receipt.manual_etr'>
                <div class="receipt-qrcode" style="font-size: 90%;">
                    <div style="display: flex; justify-content: center; align-items: center;">
                        <img t-att-src="'/report/barcode/QR/'+receipt.l10n_ke_cu_qrcode"
                             style="display:block; height:200px; width:200px;" alt="QR Code"/>
                    </div>
                </div>
                <br/>
                <div class="receipt-cu-date" style="font-size: 90%;">
                    Cu Date :
                    <span t-esc="receipt.l10n_ke_cu_datetime" class="pos-receipt-right-align"/>
                </div>
                <div class="receipt-cu-serial-no" style="font-size: 90%;">
                    Cu Serial No :
                    <span t-esc="receipt.l10n_ke_cu_serial_number" class="pos-receipt-right-align"/>
                </div>
                <div class="receipt-cu-invoice-no" style="font-size: 90%;">
                    Cu Invoice No :
                    <span t-esc="receipt.l10n_ke_cu_invoice_number" class="pos-receipt-right-align"/>
                </div>
                <hr/>
            </div>
            </div>
            <br/>
            <div t-if='receipt.receipt_footer' class="pos-receipt-center-align"
                 style="font-size: 100%; font-family: Courier New;">
                <t t-esc='receipt.receipt_footer'/>
            </div>
            <div t-if='!receipt.receipt_footer and receipt.footer' class="pos-receipt-center-align">
                <br/>
                <t t-esc='receipt.footer'/>
                <br/>
            </div>
            <br/>
            <br/>
        </div>
    </t>
</templates>
