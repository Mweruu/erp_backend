<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ReprintReceiptButton" t-inherit="point_of_sale.ReprintReceiptButton" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('control-button')]" position="replace">
            <div class="control-button" t-att-class="{ 'disabled': !printRefundReceipt()}">
                <i class="fa fa-print"></i>
                <span> </span>
                <span>Print Receipt</span>
            </div>
        </xpath>
    </t>
</templates>
