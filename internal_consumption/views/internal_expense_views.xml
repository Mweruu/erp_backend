<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="internal_expense_report_wizard" model="ir.ui.view">
        <field name="name">internal_expense_report_wizard</field>
        <field name="model">internal.expense.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name='date_from'/>
                        </group>
                        <group>
                            <field name='date_to'/>
                        </group>
                    </group>

                    <footer>
                        <button type="object" string="Print CSV" name="action_print_internal_expense_report_csv"/>
                        <button type="object" string="Download PDF" name="action_print_internal_expense_report"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="internal_expense_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Internal Expense report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">internal.expense.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref='internal_expense_report_wizard'/>
    </record>
    <menuitem id="menu_internal_expense_report" name="Internal Expense Report"
              parent="hr_expense.menu_hr_expense_reports"
              sequence="3" action="internal_expense_report_wizard_action"/>
</odoo>