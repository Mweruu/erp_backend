<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_delivery_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="docs" />
                <t t-set="partner" t-value="o.name or False"/>

                <t t-set="address">
                    <div name="div_outgoing_address">
                        <div name="outgoing_delivery_address">
                            <span><strong>Delivery Address:</strong></span>
                            <div t-field="o.dest_warehouse_id"
                                />
                        </div>
                    </div>
                </t>

                <div class="page">
                    <h2>
                        <span t-field="o.name"/>
                    </h2>
                    <div class="row mt-4 mb-4">
                        <div t-if="o.location_id" class="col-auto col-3 mw-100 mb-2" name="div_origin">
                            <strong>From:</strong>
                            <p t-field="o.location_id" class="m-0"/>
                        </div>
                        <div t-if="o.location_dest_id" class="col-auto col-3 mw-100 mb-2" name="div_origin">
                            <strong>To:</strong>
                            <p t-field="o.location_dest_id" class="m-0"/>
                        </div>
                        <div t-if="o.date" class="col-auto col-3 mw-100 mb-2"  name="div_sched_date">
                            <strong>Shipping Date:</strong>
                            <t t-if="o.state == 'done'">
                                <p t-field="o.date" class="m-0"/>
                            </t>
                            <t t-if="o.state != 'done'">
                                <p t-field="o.date" class="m-0"/>
                            </t>
                        </div>
                    </div>
                    <table class="table table-sm" t-if="o.state !='done'" name="stock_move_table">
                        <thead>
                            <tr>
                                <th name="th_sm_product"><strong>Product</strong></th>
                                <th name="th_sm_ordered"><strong>Ordered</strong></th>
                                <th name="th_sm_quantity"><strong>Delivered</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="lines" t-value="o.line_ids.filtered(lambda x: x.product_uom_id)"/>
                            <tr t-foreach="lines" t-as="move">
                                <td>
                                    <span t-field="move.product_id"/>
                                </td>
                                <td>
                                    <span t-field="move.transfer_qty"/>
                                    <span t-field="move.product_uom_id"/>
                                </td>
                                <td>
                                    <span t-field="move.quantity_done"/>
                                    <span t-field="move.product_uom_id"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-sm" t-if="o.state =='done'" name="stock_move_table">
                        <thead>
                            <tr>
                                <th name="th_sm_product"><strong>Product</strong></th>
                                <th name="th_sm_ordered"><strong>Ordered</strong></th>
                                <th name="th_sm_quantity"><strong>Delivered</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="lines" t-value="o.line_ids.filtered(lambda x: x.product_uom_id)"/>
                            <tr t-foreach="lines" t-as="move">
                                <td>
                                    <span t-field="move.product_id"/>
                                </td>
                                <td>
                                    <span t-field="move.transfer_qty"/>
                                    <span t-field="move.product_uom_id"/>
                                </td>
                                <td>
                                    <span t-field="move.quantity_done"/>
                                    <span t-field="move.product_uom_id"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
         </t>
    </template>
    <template id="report_deliveryslip">
        <t t-foreach="docs" t-as="o">
            <t t-call="internal_stock_transfer_app.report_delivery_document"/>
        </t>
    </template>
</odoo>
