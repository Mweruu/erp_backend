<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="internal_stock_move_report_wizard" model="ir.ui.view">
        <field name="name">internal_stock_move_report_wizard</field>
        <field name="model">internal.stock.move.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name='date_from'/>
                        </group>
                        <group>
                            <field name='date_to'/>
                        </group>
                    </group>

                    <footer>
                        <button type="object" string="Print CSV" name="action_print_stock_move_csv"/>
                        <button type="object" string="Download PDF" name="action_print_stock_move_report"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="internal_stock_move_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Internal Stock Move Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">internal.stock.move.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref='internal_stock_move_report_wizard'/>
    </record>
    <menuitem id="menu_action_internal_stock_move" name="Internal Stock Move Report"
              action="internal_stock_move_report_wizard_action" sequence="13" parent="stock.menu_warehouse_report"/>
</odoo>
